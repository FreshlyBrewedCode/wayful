#!/bin/sh
# This local entrypoint intentionally owns runtime diagnostics before Bun loads
# the TypeScript command dispatcher.
set -eu

SCRIPT_DIR=${0%/*}
if [ "$SCRIPT_DIR" = "$0" ]; then
  SCRIPT_DIR=.
fi

required_version=$(/usr/bin/grep -E '"bun"' "$SCRIPT_DIR/package.json" | /usr/bin/sed -E 's/.*>=([0-9]+\.[0-9]+\.[0-9]+).*/\1/')

if ! command -v bun >/dev/null 2>&1; then
  echo "wayful: Bun $required_version or later is required; install Bun and try again." >&2
  exit 2
fi

installed_version=$(bun --version)

required_major=${required_version%%.*}
required_rest=${required_version#*.}
required_minor=${required_rest%%.*}
required_patch=${required_rest#*.}
# A prerelease is lower than its corresponding release. Strip build metadata
# only after retaining whether the installed version has a prerelease suffix.
installed_without_build=${installed_version%%+*}
installed_core=${installed_without_build%%-*}
installed_prerelease=false
case "$installed_without_build" in *-*) installed_prerelease=true ;; esac
installed_major=${installed_core%%.*}
installed_rest=${installed_core#*.}
installed_minor=${installed_rest%%.*}
installed_patch=${installed_rest#*.}

# SemVer numeric prerelease identifiers must not include leading zeroes.
# Non-numeric identifiers (including mixed alphanumeric identifiers) remain valid.
if printf '%s\n' "$installed_version" | /usr/bin/grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-([1-9][0-9]*|0|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\.([1-9][0-9]*|0|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'; then
  invalid_version=false
else
  invalid_version=true
fi
case "$installed_major:$installed_minor:$installed_patch" in
  *[!0-9:]* | *::* | :* | *:) invalid_version=true ;;
  *) ;;
esac

if [ "$invalid_version" = true ] || [ "$installed_major" -lt "$required_major" ] || { [ "$installed_major" -eq "$required_major" ] && { [ "$installed_minor" -lt "$required_minor" ] || { [ "$installed_minor" -eq "$required_minor" ] && { [ "$installed_patch" -lt "$required_patch" ] || { [ "$installed_patch" -eq "$required_patch" ] && [ "$installed_prerelease" = true ]; }; }; }; }; }; then
  echo "wayful: Bun $required_version or later is required; found $installed_version." >&2
  exit 2
fi

exec bun "$SCRIPT_DIR/src/main.ts" "$@"
