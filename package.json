{
  "name": "wayful",
  "private": true,
  "workspaces": [
    "packages/*",
    "prototypes/*"
  ],
  "engines": {
    "bun": ">=1.4.1"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "build": "bun run --filter '@wayful/cli' build",
    "test": "bun run --filter './packages/*' test",
    "test:live": "bun run --filter '@wayful/cli' test:live",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "oxfmt --check packages && oxlint packages",
    "lint:effect": "oxlint packages/cli/src --config packages/cli/.oxlintrc.effect.json",
    "format": "oxfmt packages",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@playwright/cli": "^0.1.19",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.4.1",
    "@wayful/cli": "workspace:*",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
